{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "daily-news-digest",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-26",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}
